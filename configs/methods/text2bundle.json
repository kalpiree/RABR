{
  "algorithm": {
    "implementation": "external_amazon_lightgcn_fm_roberta_double_dqn",
    "lightgcn_assets_path": "${RABR_T2B_LIGHTGCN_PATH}",
    "fm_assets_path": "${RABR_T2B_FM_PATH}",
    "text_encoder_path": "${RABR_T2B_ROBERTA_PATH}",
    "text_projection_path": "${RABR_T2B_TEXT_PROJECTION_PATH}",
    "text_embedding_size": 384,
    "text_pooling": "mean",
    "device": "cpu",
    "hidden_size": 320,
    "projection_hidden_size": 64,
    "heads": 2,
    "layers": 1,
    "dropout": 0.1,
    "pretrain_steps": 500,
    "learning_rate": 0.00005,
    "updates": 20000,
    "eval_every": 1000,
    "batch_size": 256,
    "replay_size": 20000,
    "discount": 0.99,
    "epsilon_min": 0.05,
    "target_update": 100,
    "candidate_count": 50,
    "similarity_threshold": 0.3,
    "history_length": 20,
    "max_bundle_size": 5,
    "main_reward_weight": 3.0,
    "cpu_threads": 4
  }
}
