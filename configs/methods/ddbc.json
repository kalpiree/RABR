{
  "algorithm": {
    "device": "cuda",
    "steps": 20000,
    "eval_every": 500,
    "batch_size": 64,
    "learning_rate": 0.0003,
    "warmup_steps": 500,
    "ema_decay": 0.9999,
    "sampling_steps": 25,
    "codebook_size": 256,
    "pca_dimensions": 0,
    "tokenizer_seed": 42,
    "cpu_threads": 8,
    "feature_mode": "clhe",
    "clhe_manifest": "${RABR_DDBC_CLHE_MANIFEST}",
    "context_mode": "provided_seed_items",
    "decoder": "levelwise",
    "output_mode": "completion_only",
    "evaluation_protocol": "supplied_seed_completion",
    "evaluation_target_policy": "gold_excludes_supplied_seed_items"
  }
}
