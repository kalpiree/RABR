{
  "algorithm": {
    "byob_source_path": "${BYOB_SOURCE_PATH}",
    "byob_assets_path": "${BYOB_ASSETS_PATH}",
    "device": "cpu",
    "hidden_dim": 128,
    "heads": 4,
    "epochs": 100,
    "batch_size": 16,
    "training_bundle_size": 3,
    "pool_size": 20,
    "sequence_length": 20,
    "embed_dim": 32,
    "pointer_hidden_dim": 128,
    "pool_transformer": false,
    "concat_bundle": false,
    "dropout": 0.1,
    "reward_epochs": 10,
    "reward_batch_size": 256,
    "reward_learning_rate": 0.001,
    "compatibility_learning_rate": 0.001,
    "context_window": 5,
    "compatibility_negatives": 15,
    "item_policy_epochs": 50,
    "bundle_policy_epochs": 50,
    "bundle_metric": "recall",
    "neighbor_threshold": 0.0,
    "rl_learning_rate": 0.0003,
    "ppo_updates": 4,
    "ppo_clip": 0.2,
    "rl_batch_size": 128,
    "evaluation_protocol": "native",
    "exploration_rate": 0.0,
    "patience": 10
  }
}
