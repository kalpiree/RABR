{
  "algorithm": {
    "evaluation_protocol": "interactive_target_feedback",
    "catalog_metadata_path": "${RABR_BUNT_METADATA_PATH}",
    "history_bundles_path": "${RABR_BUNT_HISTORY_PATH}",
    "device": "cpu",
    "epochs": 100,
    "batch_size": 32,
    "learning_rate": 0.001,
    "patience": 10,
    "grad_clip": 0.5,
    "dropout": 0.2,
    "hidden_dim": 32,
    "heads": 1,
    "layers": 1,
    "max_rounds": 20,
    "slots_per_round": 2,
    "tag_mask_probability": 0.5,
    "ask_loss_weight": 0.1,
    "online_episodes": 50000,
    "rollout_episodes": 16,
    "rl_learning_rate": 0.001,
    "ppo_updates": 10,
    "ppo_clip": 0.2,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "value_coefficient": 0.2,
    "rl_batch_size": 128
  }
}
