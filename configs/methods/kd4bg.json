{
  "algorithm": {
    "mode": "teacher_student",
    "student_model": "${RABR_STUDENT_MODEL_PATH}",
    "device": "cuda",
    "epochs": 3,
    "learning_rate": 0.0002,
    "lora_rank": 16,
    "lora_alpha": 16,
    "gradient_accumulation": 4,
    "max_sequence_length": 2048,
    "minimum_support": 2,
    "pattern_count": 8,
    "rule_neighbors": 1,
    "local_files_only": true,
    "teacher_backend": {
      "type": "transformers",
      "model_path": "${RABR_KD_TEACHER_PATH}",
      "device": "cuda",
      "dtype": "bfloat16",
      "temperature": 0.7
    },
    "batch_size": 2,
    "warmup_steps": 5,
    "weight_decay": 0.01,
    "lr_scheduler": "linear",
    "checkpoint_selection": "final_epoch",
    "load_in_4bit": true,
    "shuffle_seed": 65,
    "adapter_seed": 3407
  }
}
